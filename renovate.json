{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes\\/.+\\.ya?ml$/"
    ],
    "ignorePaths": [
      "kubernetes/components/flux-system/**"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^kubernetes\\/(components|apps)\\/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^kubernetes\\/components\\/home-assistant\\/custom-components\\.yaml$/"
      ],
      "datasourceTemplate": "github-releases",
      "matchStrings": [
        "github\\.com/(?<depName>[^|]+?)/releases/download/(?<currentValue>[^/|]+)/[^/|]+\\.zip",
        "github\\.com/(?<depName>[^|]+?)/archive/refs/tags/(?<currentValue>[^/|]+)\\.zip"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^hallon\\/ansible\\/group_vars\\/.+\\.yml$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Koenkk/zigbee2mqtt",
      "matchStrings": [
        "zigbee2mqtt_version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "flux-system is managed by Terraform; parse only, never update",
      "matchFileNames": [
        "kubernetes/components/flux-system/**"
      ],
      "enabled": false
    },
    {
      "description": "Minor and patch updates grouped per dependency",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "{{depName}}",
      "groupSlug": "{{depName}}"
    },
    {
      "description": "Major updates get their own PR",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "{{depName}} (major)",
      "groupSlug": "{{depName}}-major"
    },
    {
      "description": "Hermes image uses SemVer tags since v0.21.6; older CalVer tags (v2026.*) sort newer",
      "matchPackageNames": [
        "nousresearch/hermes-agent",
        "/^docker\\.io\\/nousresearch\\/hermes-agent$/"
      ],
      "versioning": "semver",
      "allowedVersions": "/^v?0\\./"
    }
  ]
}
