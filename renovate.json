{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "terraform": {
    "managerFilePatterns": [
      "//kubernetes/bootstrap/flux/.+\\.tf$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "//kubernetes/components/.+\\.yaml$/"
    ],
    "ignorePaths": [
      "kubernetes/components/flux-system/**"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "//kubernetes/components/.+\\.yaml$/"
    ],
    "ignorePaths": [
      "kubernetes/components/flux-system/**"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "//kubernetes/components/.+\\.yaml$/"
    ],
    "ignorePaths": [
      "kubernetes/components/flux-system/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "//kubernetes/components/.+\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s+\"(?<currentValue>.+?)\"\\s+# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>.+?))?\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Ignore flux-system components - managed by Terraform",
      "matchFileNames": [
        "kubernetes/components/flux-system/**"
      ],
      "enabled": false
    },
    {
      "description": "Enable Terraform updates for Flux bootstrap",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "kubernetes/bootstrap/flux/**"
      ],
      "enabled": true
    },
    {
      "description": "Enable Docker updates in components (excluding flux-system)",
      "matchCategories": [
        "docker"
      ],
      "enabled": true
    },
    {
      "description": "Separate PRs for each Helm release - minor and patch grouped",
      "matchDatasources": [
        "helm"
      ],
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "groupName": "{{depName}}",
      "groupSlug": "helm-{{depName}}",
      "commitMessageTopic": "{{depName}} Helm release"
    },
    {
      "description": "Separate PRs for Helm major version updates",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "{{depName}} (major)",
      "groupSlug": "helm-{{depName}}-major",
      "commitMessageTopic": "{{depName}} Helm release"
    },
    {
      "description": "Separate PRs for each container image - minor and patch grouped",
      "matchDatasources": [
        "docker"
      ],
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "groupName": "{{depName}}",
      "groupSlug": "container-{{depName}}",
      "commitMessageTopic": "{{depName}} container image"
    },
    {
      "description": "Separate PRs for container major version updates",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "{{depName}} (major)",
      "groupSlug": "container-{{depName}}-major",
      "commitMessageTopic": "{{depName}} container image"
    }
  ]
}
